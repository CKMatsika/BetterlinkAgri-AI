# ==============================================================================
# BETTERLINK AGR AI — ZIMBABWE WHITE-LABEL AI AGRI-INPUT SALES REPRESENTATIVE
# Environment Configuration Template (.env.example)
# ==============================================================================

APP_NAME="BetterlinkAgr AI"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Africa/Harare
APP_URL=http://localhost:8000
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_SUPPORTED_LOCALES=en,sn,nd

# ==============================================================================
# FILAMENT MULTI-PANEL PATHS (Platform Admin, Tenant Admin, Outlet Portal)
# ==============================================================================
FILAMENT_PLATFORM_PANEL_PATH=platform
FILAMENT_TENANT_PANEL_PATH=admin
FILAMENT_OUTLET_PANEL_PATH=outlet

# ==============================================================================
# LOGGING & OBSERVABILITY
# ==============================================================================
LOG_CHANNEL=stack
LOG_STACK=single,stderr
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.2
SENTRY_PROFILES_SAMPLE_RATE=0.1
SENTRY_SEND_DEFAULT_PII=false

# ==============================================================================
# DATABASE (PostgreSQL 16 + pgvector + PostGIS)
# ==============================================================================
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=betterlink_agr_ai
DB_USERNAME=betterlink
DB_PASSWORD=secret
DB_CHARSET=utf8
DB_SSLMODE=prefer
# Vector embedding dimension (1024 for Voyage-3 / 1536 for OpenAI text-embedding-3-small)
PGVECTOR_DIMENSION=1024
POSTGIS_SRID=4326

# ==============================================================================
# CACHE, SESSIONS, QUEUES & HORIZON (Redis)
# ==============================================================================
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=redis
CACHE_PREFIX=betterlink_cache_

QUEUE_CONNECTION=redis
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_QUEUE_DB=2

HORIZON_DOMAIN=null
HORIZON_PATH=horizon
HORIZON_PREFIX=betterlink_horizon:

# ==============================================================================
# FILESYSTEM & MEDIA PROCESSING
# ==============================================================================
FILESYSTEM_DISK=local
MEDIA_DISK=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=af-south-1
AWS_BUCKET=betterlink-agr-media
AWS_USE_PATH_STYLE_ENDPOINT=false

# Image intake compression & quality thresholds
IMAGE_MAX_UPLOAD_MB=10
IMAGE_TARGET_MAX_WIDTH=1280
IMAGE_JPEG_QUALITY=82
IMAGE_MIN_RESOLUTION_PX=400
IMAGE_MIN_BRIGHTNESS_SCORE=35
IMAGE_MAX_BRIGHTNESS_SCORE=235
IMAGE_MIN_LAPLACIAN_VARIANCE=60.0
IMAGE_MAX_POOR_PHOTO_RETRIES=2

# ==============================================================================
# AI PROVIDER CONFIGURATION (Google Gemini / Anthropic Claude + Embeddings + Voice STT)
# ==============================================================================
AI_DEFAULT_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
ANTHROPIC_API_VERSION=2023-06-01
ANTHROPIC_VISION_MODEL=claude-sonnet-5-5
ANTHROPIC_REASONING_MODEL=claude-sonnet-5-5
ANTHROPIC_FAST_MODEL=claude-haiku-5-5
ANTHROPIC_MAX_TOKENS=2048
ANTHROPIC_TEMPERATURE=0.1
ANTHROPIC_REQUEST_TIMEOUT=45

GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_VISION_MODEL=gemini-2.5-flash
GEMINI_REASONING_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# Embeddings Provider for Tenant RAG (voyage | openai)
AI_EMBEDDING_PROVIDER=voyage
VOYAGE_API_KEY=
VOYAGE_BASE_URL=https://api.voyageai.com/v1
VOYAGE_EMBEDDING_MODEL=voyage-3

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Voice Note Transcription (Speech-to-Text for English, Shona, Ndebele)
VOICE_STT_PROVIDER=openai_whisper
VOICE_STT_MODEL=whisper-1
VOICE_MAX_DURATION_SECONDS=120

# ==============================================================================
# STATE MACHINE, DIAGNOSIS ENGINE & GUARDRAILS DEFAULTS
# ==============================================================================
DIAGNOSIS_HIGH_CONFIDENCE_THRESHOLD=0.80
DIAGNOSIS_MIN_CONFIDENCE_THRESHOLD=0.55
DIAGNOSIS_MAX_CLARIFYING_QUESTIONS=5
DIAGNOSIS_TOP_CANDIDATES_COUNT=3
DIAGNOSIS_RAG_TOP_K=6
DIAGNOSIS_RAG_MIN_SIMILARITY=0.72

# Follow-up Check-in Defaults (days)
FOLLOW_UP_PEST_DISEASE_DAYS=7
FOLLOW_UP_NUTRIENT_DAYS=14
FOLLOW_UP_LIVESTOCK_DAYS=3
FOLLOW_UP_MAX_REMINDERS=2

# Outbreak Alert Thresholds (cases of same pest/disease in same ward within window)
OUTBREAK_ALERT_CASE_THRESHOLD=5
OUTBREAK_ALERT_WINDOW_DAYS=7

# ==============================================================================
# LOCATION-AWARE OUTLET FINDER, RESERVATIONS & SLAs (PostGIS)
# ==============================================================================
OUTLET_SEARCH_RADII_KM="25,50,100"
OUTLET_STOCK_FRESHNESS_LIMIT_HOURS=48
OUTLET_RESERVATION_SLA_MINUTES=30
OUTLET_STALE_REMINDER_HOUR="07:30"
LOCATION_AWAIT_TIMEOUT_HOURS=24
# Default Outlet Ranking Weights (must sum to 1.00)
OUTLET_WEIGHT_STOCK_CONFIDENCE=0.35
OUTLET_WEIGHT_DISTANCE=0.30
OUTLET_WEIGHT_OPEN_NOW=0.15
OUTLET_WEIGHT_DELIVERY=0.10
OUTLET_WEIGHT_PRICE=0.10

# Lead & Rep SLAs
LEAD_REP_SLA_MINUTES=120
LEAD_HOT_SLA_MINUTES=30
AGRONOMIST_ESCALATION_SLA_MINUTES=60

# ==============================================================================
# ZIMBABWE LOCALISATION, CURRENCY & AGRONOMY DEFAULTS
# ==============================================================================
ZW_SUPPORTED_CURRENCIES=USD,ZIG
ZW_DEFAULT_CURRENCY=USD
# Indicative USD -> ZiG exchange rate when not overridden by tenant
ZW_DEFAULT_USD_TO_ZIG_RATE=25.50
ZW_DEFAULT_COUNTRY_CODE=263
ZW_OPT_OUT_KEYWORDS="STOP,MIRA,MANA"
ZW_OPT_IN_KEYWORDS="START,TANGA,QALA"

# Pfumvudza / Intwasa Standard Plot Constants (39m x 16m = 624m2, 52 rows x 28 stations = 1456 stations)
PFUMVUDZA_PLOT_AREA_M2=624
PFUMVUDZA_STANDARD_STATIONS=1456
PFUMVUDZA_PLANTS_PER_STATION=2
STANDARD_KNAPSACK_LITRES=16
STANDARD_FERTILISER_BAG_KG=50

# ==============================================================================
# WHATSAPP CLOUD API (Meta Graph API v21.0)
# ==============================================================================
WHATSAPP_ENABLED=true
WHATSAPP_GRAPH_URI=https://graph.facebook.com
WHATSAPP_GRAPH_VERSION=v21.0
WHATSAPP_APP_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_TOLERANCE_SECONDS=300
WHATSAPP_IDEMPOTENCY_TTL_SECONDS=86400

# ==============================================================================
# SMS & USSD GATEWAY FALLBACK (Econet / NetOne / Africa's Talking / Infobip)
# ==============================================================================
SMS_GATEWAY_DRIVER=africastalking
AFRICASTALKING_USERNAME=sandbox
AFRICASTALKING_API_KEY=
AFRICASTALKING_FROM=BETTERLINK
AFRICASTALKING_USSD_SERVICE_CODE=*384*263#
SMS_WEBHOOK_SECRET=

# ==============================================================================
# WEATHER FORECAST SERVICE (Ward-Level Spraying Window & Agronomy Context)
# ==============================================================================
WEATHER_PROVIDER=openweathermap
OPENWEATHERMAP_API_KEY=
OPENWEATHERMAP_BASE_URL=https://api.openweathermap.org/data/2.5
WEATHER_CACHE_TTL_MINUTES=60
SPRAY_MAX_WIND_SPEED_KMH=15.0
SPRAY_MIN_WIND_SPEED_KMH=3.0
SPRAY_MAX_RAIN_PROBABILITY_PCT=30
SPRAY_RAIN_FREE_WINDOW_HOURS=4
SPRAY_MAX_TEMP_CELSIUS=30.0

# ==============================================================================
# PAYMENTS (Phase 2 Integration: EcoCash / Paynow Zimbabwe)
# ==============================================================================
PAYNOW_ENABLED=false
PAYNOW_INTEGRATION_ID=
PAYNOW_INTEGRATION_KEY=
PAYNOW_RESULT_URL="${APP_URL}/api/v1/payments/paynow/webhook"
PAYNOW_RETURN_URL="${APP_URL}/payments/return"

# ==============================================================================
# CRM / ERP ADAPTERS (Standalone, CSV, Signed Webhooks, HubSpot, Zoho)
# ==============================================================================
CRM_WEBHOOK_SIGNING_SECRET=
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_ACCOUNTS_URL=https://accounts.zoho.com

# ==============================================================================
# DATA PROTECTION & SECURITY (Zimbabwe Cyber and Data Protection Act [Cap 12:07])
# ==============================================================================
CDPA_REQUIRE_EXPLICIT_CONSENT=true
CDPA_RETENTION_DAYS=1095
CDPA_DPO_EMAIL=dpo@betterlinkagr.co.zw
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,127.0.0.1,127.0.0.1:8000,::1

# ==============================================================================
# MAIL & NOTIFICATIONS
# ==============================================================================
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="advisory@betterlinkagr.co.zw"
MAIL_FROM_NAME="${APP_NAME}"


# ==============================================================================
# LARAVEL REVERB (WEBSOCKETS FOR LIVE MARKETPLACE COUNTERS & OUTLET ALERTS)
# ==============================================================================
BROADCAST_CONNECTION=log
REVERB_APP_ID=betterlink
REVERB_APP_KEY=betterlink-local-key
REVERB_APP_SECRET=betterlink-local-secret
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http
