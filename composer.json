{
    "name": "betterlink/betterlink-agr-ai",
    "type": "project",
    "description": "BetterlinkAgr AI — White-Label Multi-Tenant AI Agri-Input Sales Representative for Zimbabwe",
    "keywords": [
        "laravel",
        "agritech",
        "zimbabwe",
        "whatsapp",
        "claude-vision",
        "gemini-vision",
        "pgvector",
        "postgis",
        "filament"
    ],
    "license": "proprietary",
    "require": {
        "php": "^8.3|^8.4",
        "ext-bcmath": "*",
        "ext-gd": "*",
        "ext-pdo": "*",
        "barryvdh/laravel-dompdf": "^3.1",
        "filament/filament": "^3.2",
        "guzzlehttp/guzzle": "^7.9",
        "laravel/framework": "^11.31",
        "laravel/horizon": "^5.51",
        "laravel/reverb": "^1.13",
        "laravel/sanctum": "^4.0",
        "laravel/tinker": "^2.9",
        "league/flysystem-aws-s3-v3": "^3.29",
        "pgvector/pgvector": "^0.2.1",
        "predis/predis": "^2.2",
        "smalot/pdfparser": "^2.11"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/pint": "^1.18",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.5",
        "pestphp/pest": "^3.5",
        "pestphp/pest-plugin-laravel": "^3.0"
    },
    "suggest": {
        "ext-exif": "Required for extracting GPS EXIF coordinates before stripping metadata",
        "ext-pdo_pgsql": "Required for PostgreSQL + pgvector + PostGIS in production",
        "ext-redis": "Recommended for phpredis driver and Laravel Horizon in Linux/Docker"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "lint": "pint --test",
        "test": "pest"
    },
    "extra": {
        "laravel": {
            "dont-discover": [
                "pgvector/pgvector"
            ]
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "audit": {
            "block-insecure": false
        },
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
